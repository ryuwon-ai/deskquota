+CODEX_TOOL_CONTENT = "TASK4_CODEX_SYNTHETIC_READ_RESULT"
+CODEX_TOOL_CALL_ID = "call_task4_codex_read"
+CLAUDE_TOOL_MARKER = "TASK4_CLAUDE_TOOL_OK"
