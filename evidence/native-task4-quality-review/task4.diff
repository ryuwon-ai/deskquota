+    fs::set_permissions(&pi, fs::Permissions::from_mode(0o700)).unwrap();
+    let home = fixture.path("client-home");
+    let binary = env!("CARGO_BIN_EXE_llmgw");
+    let base_args = [
+        "--config",
+        config.to_str().unwrap(),
+        "connect",
+        "pi",
+        "--client-executable",
