+def isolated_pi_environment(temp: Path, home: Path, agent_dir: Path) -> dict[str, str]:
+    environment = {
+        "PATH": os.environ.get("PATH", "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"),
