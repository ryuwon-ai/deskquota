+        assert_eq!(
+            lifecycle_action(ApplyMode::SaveAndStart, &matching).unwrap(),
+            LifecycleAction::On
+        );
+        let unverified = RuntimeImpact::Unverified {
+            desired_fingerprint: "desired".into(),
+        };
+        assert!(lifecycle_action(ApplyMode::SaveAndRestart, &unverified).is_err());
+        assert_eq!(
