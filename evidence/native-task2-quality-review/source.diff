+    #[test]
+    fn verified_windows_replace_removes_recovery_copies() {
+        let parent = std::env::temp_dir().join(format!(
+            "llmgw-windows-success-{}-{:016x}",
+            std::process::id(),
+            rand::random::<u64>()
+        ));
