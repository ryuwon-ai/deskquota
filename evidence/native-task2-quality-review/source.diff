+        };
+        assert_eq!(
+            lifecycle_action(ApplyMode::SaveAndRestart, &impact).unwrap(),
+            LifecycleAction::Restart
+        );
+        let error = lifecycle_action(ApplyMode::SaveAndStart, &impact)
