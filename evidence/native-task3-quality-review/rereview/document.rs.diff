+
+fn toml_item_at<'a>(table: &'a dyn TableLike, path: &[String]) -> Option<&'a Item> {
+    let (head, tail) = path.split_first()?;
+    let item = table.get(head)?;
+    if tail.is_empty() {
+        Some(item)
+    } else {
+        toml_item_at(item.as_table_like()?, tail)
+    }
+}
+
+fn toml_item_contains_datetime(item: &Item) -> bool {
+    match item {
+        Item::None => false,
+        Item::Value(value) => toml_value_contains_datetime(value),
+        Item::Table(table) => table
+            .iter()
+            .any(|(_, item)| toml_item_contains_datetime(item)),
+        Item::ArrayOfTables(tables) => tables.iter().any(|table| {
+            table
+                .iter()
+                .any(|(_, item)| toml_item_contains_datetime(item))
+        }),
+    }
+}
+
+fn toml_value_contains_datetime(value: &Value) -> bool {
+    match value {
+        Value::Datetime(_) => true,
+        Value::Array(array) => array.iter().any(toml_value_contains_datetime),
+        Value::InlineTable(table) => table
+            .iter()
+            .any(|(_, value)| toml_value_contains_datetime(value)),
+        Value::String(_) | Value::Integer(_) | Value::Float(_) | Value::Boolean(_) => false,
+    }
 }
 
