+pub(crate) fn server_forbids_retry(headers: &HeaderMap) -> bool {
+    headers.get_all("x-should-retry").iter().any(|value| {
+        value
+            .to_str()
+            .ok()
+            .is_some_and(|value| value.trim_matches([' ', '\t']) == "false")
+    })
+}
