+        try:
+            connection.request("POST" if path == "stop" else "GET", f"/_llmgw/{path}",
+                               headers={"X-LLMGW-Control-Token": self.control_token,
+                                        "Connection": "close"})
+            response = connection.getresponse()
+            return response.status, json.loads(response.read())
+        finally:
+            connection.close()
