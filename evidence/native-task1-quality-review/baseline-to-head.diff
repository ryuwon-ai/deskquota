+                        "force_shutdown": True, "passed": True, "upstream_attempts": 1,
+                        "upstream_close_observed": True, "body_eof_gate_completed": False,
+                        "control_stop_exit_zero": True, "observed_stop_seconds": round(elapsed, 3)}
