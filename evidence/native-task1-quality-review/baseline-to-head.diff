+    def queued(self, count):
+        def matched():
+            status, data = self.control("status")
+            require(status == 200, "status_http")
+            admission = data.get("admission")
+            require(isinstance(admission, dict), "admission_status_missing")
+            roots = admission.get("roots", [])
