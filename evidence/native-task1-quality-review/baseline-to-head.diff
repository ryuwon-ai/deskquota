+#!/usr/bin/env python3
+"""Exercise the foreground product binary with temporary state and loopback only."""
+
+import argparse
+import hashlib
+import http.client
+import http.server
+import json
+from pathlib import Path
+import platform
+import secrets
+import socket
+import subprocess
+import tempfile
+import threading
