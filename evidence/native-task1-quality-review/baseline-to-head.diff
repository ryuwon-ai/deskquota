+SUCCESS = b'{"fixture":"complete"}'
+TRANSIENT = b'{"error":{"type":"rate_limit_error","code":"slow_down"}}'
+RATE = b'{"error":{"type":"tokens","code":"rate_limit_exceeded"}}'
