{
  "version": 2,
  "client": {
    "drop_excess_requests": true,
    "initial_pool_size": 64,
    "enable_logging": false,
    "disable_content_logging": true,
    "enforce_auth_on_inference": false,
    "header_filter_config": {
      "allowlist": [
        "x-benchmark-ingress"
      ]
    },
    "compat": {
      "convert_text_to_chat": false,
      "convert_chat_to_responses": false,
      "should_drop_params": false,
      "should_convert_params": false
    }
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "<RUN_APP_DIR>/config.db"
    }
  },
  "logs_store": {
    "enabled": false
  },
  "framework": {
    "pricing": {
      "pricing_url": "file:///Users/ryuwon/Library/Caches/deskquota-reference-runtimes/2026-09-15/native/bifrost-app/pricing.json",
      "model_parameters_url": "file:///Users/ryuwon/Library/Caches/deskquota-reference-runtimes/2026-09-15/native/bifrost-app/model-parameters.json",
      "pricing_sync_interval": 86400,
      "mcp_library_sync_interval": 0,
      "live_models_sync_interval": 0
    }
  },
  "providers": {
    "openai": {
      "keys": [
        {
          "name": "fixture",
          "value": "fixture-only-not-a-secret",
          "models": [
            "synthetic"
          ],
          "weight": 1
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:18771",
        "max_retries": 0,
        "default_request_timeout_in_seconds": 120,
        "stream_idle_timeout_in_seconds": 120
      },
      "concurrency_and_buffer_size": {
        "concurrency": 2,
        "buffer_size": 64
      }
    }
  },
  "plugins": [
    {
      "name": "telemetry",
      "enabled": false,
      "config": {}
    },
    {
      "name": "semantic_cache",
      "enabled": false,
      "config": {}
    }
  ],
  "$schema": "file:///Users/ryuwon/Library/Caches/deskquota-reference-runtimes/2026-09-15/native/bifrost-v2.1.1/transports/config.schema.json",
  "governance": {
    "rate_limits": [
      {
        "id": "fixture-shared-quota",
        "token_max_limit": 6000,
        "token_reset_duration": "60s",
        "request_max_limit": 16,
        "request_reset_duration": "60s"
      }
    ],
    "providers": [
      {
        "name": "openai",
        "rate_limit_id": "fixture-shared-quota"
      }
    ]
  }
}
