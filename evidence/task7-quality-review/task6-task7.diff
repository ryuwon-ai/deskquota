+#[derive(Default)]
+struct RetryPrefix {
+    bytes: Vec<u8>,
+    extra: Option<Result<Bytes, reqwest::Error>>,
+    complete: bool,
+}
+async fn probe_rejection(response: &mut reqwest::Response) -> RetryPrefix {
+    use crate::admission::retry::MAX_ERROR_BODY;
+    let mut prefix = RetryPrefix::default();
+    // Encoded or declared oversized responses remain purely streaming.
+    if response
+        .content_length()
+        .is_some_and(|len| len > MAX_ERROR_BODY as u64)
+        || response
+            .headers()
+            .get_all("content-encoding")
+            .iter()
+            .any(|h| h != "identity")
+    {
+        return prefix;
+    }
+    loop {
+        match response.chunk().await {
+            Ok(Some(bytes)) if prefix.bytes.len().saturating_add(bytes.len()) <= MAX_ERROR_BODY => {
+                prefix.bytes.extend_from_slice(&bytes);
+            }
+            Ok(Some(bytes)) => {
+                prefix.extra = Some(Ok(bytes));
+                return prefix;
+            }
+            Ok(None) => {
+                prefix.complete = true;
+                return prefix;
+            }
+            Err(error) => {
+                prefix.extra = Some(Err(error));
+                return prefix;
             }
         }
     }
