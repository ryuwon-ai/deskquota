+async def abort_startup(proc):
+    """Reap only the Process acquired by this startup attempt, with bounded waits."""
+    if proc.returncode is None:
+        try: proc.terminate()
+        except ProcessLookupError: pass
+    try:
+        await asyncio.wait_for(proc.wait(), 3)
+    except TimeoutError:
+        try: proc.kill()
+        except ProcessLookupError: pass
+        await asyncio.wait_for(proc.wait(), 3)
